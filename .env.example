# Copiez ce fichier en .env.local et complétez les valeurs.
# Aucune variable n'est obligatoire : sans clé, le site fonctionne en mode démonstration.

# URL publique du site (URL canoniques, sitemap, images Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse qui reçoit les demandes du formulaire de contact
CONTACT_TO_EMAIL=contact@duostudio.example

# Envoi réel des e-mails via Resend (https://resend.com). Vide = mode démo (console du serveur).
RESEND_API_KEY=
# Expéditeur des e-mails : adresse d'un domaine vérifié dans Resend.
# Vide = adresse de test de Resend (ne délivre qu'à l'adresse du compte Resend).
RESEND_FROM_EMAIL=

# Cloudflare Turnstile (anti-robot facultatif). Les deux clés sont nécessaires pour l'activer.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mesure d'audience sans cookie (désactivée si vide). Plausible par défaut.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Pour Umami à la place de Plausible :
# NEXT_PUBLIC_ANALYTICS_PROVIDER=umami
# NEXT_PUBLIC_ANALYTICS_SRC=https://votre-instance-umami.example/script.js
# NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# Nombre d'envois du formulaire autorisés par heure et par adresse IP (5 par défaut)
# CONTACT_RATE_LIMIT=5
